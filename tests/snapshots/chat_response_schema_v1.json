{
  "$defs": {
    "ChatPlan": {
      "properties": {
        "task_type": {
          "description": "Machine-readable task label",
          "title": "Task Type",
          "type": "string"
        },
        "reason": {
          "description": "Human-readable routing rationale",
          "title": "Reason",
          "type": "string"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "goal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Goal"
        },
        "subgoals": {
          "items": {
            "type": "string"
          },
          "title": "Subgoals",
          "type": "array"
        },
        "resources": {
          "items": {
            "type": "string"
          },
          "title": "Resources",
          "type": "array"
        },
        "required_context": {
          "items": {
            "type": "string"
          },
          "title": "Required Context",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "plan_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Type"
        },
        "evidence_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Policy"
        },
        "stop_criteria": {
          "items": {
            "type": "string"
          },
          "title": "Stop Criteria",
          "type": "array"
        },
        "tool_chain": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Tool Chain",
          "type": "array"
        },
        "resolver_trace": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Resolver Trace",
          "type": "array"
        },
        "needs_more_context": {
          "default": false,
          "title": "Needs More Context",
          "type": "boolean"
        },
        "missing_context": {
          "items": {
            "type": "string"
          },
          "title": "Missing Context",
          "type": "array"
        },
        "follow_up_question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Follow Up Question"
        },
        "diagnostic_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiagnosticPlannerOutput"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "planner_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the plan came from: router, model, or fallback",
          "title": "Planner Source"
        }
      },
      "required": [
        "task_type",
        "reason"
      ],
      "title": "ChatPlan",
      "type": "object"
    },
    "ChatSource": {
      "properties": {
        "type": {
          "description": "Evidence source category",
          "title": "Type",
          "type": "string"
        },
        "title": {
          "description": "Short source title for display",
          "title": "Title",
          "type": "string"
        },
        "snippet": {
          "description": "Short grounded evidence text",
          "title": "Snippet",
          "type": "string"
        },
        "company": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hiring organization name",
          "title": "Company"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Job location",
          "title": "Location"
        },
        "work_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Job type such as intern or graduate",
          "title": "Work Type"
        },
        "posted_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Posting date",
          "title": "Posted At"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source link",
          "title": "Url"
        }
      },
      "required": [
        "type",
        "title",
        "snippet"
      ],
      "title": "ChatSource",
      "type": "object"
    },
    "DiagnosticHypothesis": {
      "additionalProperties": false,
      "properties": {
        "bottleneck_type": {
          "enum": [
            "insufficient_evidence",
            "application_volume",
            "resume_positioning",
            "interview_performance",
            "skill_gap",
            "job_targeting"
          ],
          "title": "Bottleneck Type",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "bottleneck_type",
        "summary",
        "rationale",
        "confidence"
      ],
      "title": "DiagnosticHypothesis",
      "type": "object"
    },
    "DiagnosticPlannerOutput": {
      "additionalProperties": false,
      "properties": {
        "diagnostic_hypotheses": {
          "items": {
            "$ref": "#/$defs/DiagnosticHypothesis"
          },
          "maxItems": 3,
          "title": "Diagnostic Hypotheses",
          "type": "array"
        },
        "evidence_to_collect": {
          "items": {
            "$ref": "#/$defs/EvidenceToCollect"
          },
          "maxItems": 5,
          "title": "Evidence To Collect",
          "type": "array"
        },
        "next_question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Question"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "stop_criteria": {
          "items": {
            "type": "string"
          },
          "title": "Stop Criteria",
          "type": "array"
        }
      },
      "required": [
        "confidence"
      ],
      "title": "DiagnosticPlannerOutput",
      "type": "object"
    },
    "EvidenceToCollect": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "profile",
            "applications",
            "interviews",
            "feedback",
            "resume",
            "job_detail"
          ],
          "title": "Source",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "priority": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Priority",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "reason",
        "priority",
        "required"
      ],
      "title": "EvidenceToCollect",
      "type": "object"
    },
    "LLMTrace": {
      "properties": {
        "planner_source": {
          "default": "not_used",
          "title": "Planner Source",
          "type": "string"
        },
        "job_search_summary_source": {
          "default": "not_used",
          "title": "Job Search Summary Source",
          "type": "string"
        },
        "generate_source": {
          "default": "not_used",
          "title": "Generate Source",
          "type": "string"
        }
      },
      "title": "LLMTrace",
      "type": "object"
    }
  },
  "properties": {
    "contract_version": {
      "const": "chat.v1",
      "default": "chat.v1",
      "description": "Stable /chat response contract version",
      "title": "Contract Version",
      "type": "string"
    },
    "answer": {
      "title": "Answer",
      "type": "string"
    },
    "stage": {
      "default": "done",
      "description": "High-level response stage",
      "title": "Stage",
      "type": "string"
    },
    "memory_used": {
      "default": false,
      "title": "Memory Used",
      "type": "boolean"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/ChatSource"
      },
      "title": "Sources",
      "type": "array"
    },
    "tool_used": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Used"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChatPlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tool_trace": {
      "items": {
        "type": "string"
      },
      "title": "Tool Trace",
      "type": "array"
    },
    "loop_trace": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Loop Trace",
      "type": "array"
    },
    "llm_trace": {
      "$ref": "#/$defs/LLMTrace"
    }
  },
  "required": [
    "answer"
  ],
  "title": "ChatResponse",
  "type": "object"
}
