# ── LLM（主力模型，兼容 OpenAI API 格式）──────────────────────────────
# DashScope 示例（推荐）：
OPENAI_API_KEY=sk-your-dashscope-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_MODEL=qwen-plus

# ── Planner / Generator（可与主力模型相同）────────────────────────────
PLANNER_API_KEY=sk-your-dashscope-key
PLANNER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PLANNER_MODEL=qwen-plus
GENERATOR_MODEL=qwen-plus

# ── 多模态（简历图片解析，不填则跳过）────────────────────────────────
VISION_MODEL=qwen-vl-plus
VISION_API_KEY=sk-your-dashscope-key
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 数据库 & 向量库路径（默认值可直接使用）───────────────────────────
DB_PATH=data/career_agent.db
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=job_postings_v2

# ── 其他可选配置 ──────────────────────────────────────────────────────
# PLANNER_DISABLE_THINKING=true   # Qwen3 系列关闭 thinking 模式
